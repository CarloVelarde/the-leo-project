{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["tests/*"]
    }
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.mdx"]
}
